  <!-- Scripts -->
  <script src="js/jquery.min.js"></script>
  <script src="js/jquery-migrate-3.0.1.min.js"></script>
  <script src="js/popper.min.js"></script>
  <script src="js/bootstrap.min.js"></script>
  <script src="js/jquery.easing.1.3.js"></script>
  <script src="js/jquery.waypoints.min.js"></script>
  <script src="js/jquery.stellar.min.js"></script>
  <script src="js/owl.carousel.min.js"></script>
  <script src="js/jquery.magnific-popup.min.js"></script>
  <script src="js/aos.js"></script>
  <script src="js/jquery.animateNumber.min.js"></script>
  <script src="js/bootstrap-datepicker.js"></script>
  <script src="js/scrollax.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
  <script src="js/main.js"></script>
  <script src="js/customer-api.js"></script>
  <!-- Flatpickr JS -->
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>

  <script>
    // Simple showConfirm fallback if not defined elsewhere
    window.showConfirm = window.showConfirm || function(title, message, btnConfirm, btnCancel) {
      return new Promise(resolve => {
        resolve(window.confirm(message));
      });
    };

    const urlParams = new URLSearchParams(window.location.search);
    const roomId = urlParams.get('id');
    const API_ROOMS = location.origin + '/api/rooms';
    
    let currentRoom = null; // Store room data
    let lastLoadedRoomId = null; // Track room changes to clear coupon
    
    // CRITICAL: Clear any existing coupon when page loads (fresh start)
    // Coupons should only apply to the current booking session
    (function() {
      console.log('ðŸ”„ [Page Load] Clearing any existing coupon from previous session');
      window.coupons?.clearAppliedCoupon && window.coupons.clearAppliedCoupon();
    })();

    function vnd(n) {
      try {
        return new Intl.NumberFormat('vi-VN', {style:'currency', currency:'VND'}).format(n || 0);
      } catch(_) {
        return (n || 0) + 'â‚«';
      }
    }

    // Initialize Flatpickr for booking dates
    async function initFlatpickr(roomId) {
      let bookedDates = [];
      try {
        const resp = await fetch(`${location.origin}/api/bookings/room/${roomId}/booked-dates`);
        if (resp.ok) {
          const data = await resp.json();
          if (Array.isArray(data)) {
            bookedDates = data;
          }
        }
      } catch (e) {
        console.error('Error fetching booked dates', e);
      }

      const commonConfig = {
        locale: "vn",
        minDate: "today",
        disable: bookedDates,
        mode: "range",
        dateFormat: "Y-m-d",
        onChange: function(selectedDates, dateStr, instance) {
          if (selectedDates.length === 2) {
            // Update the hidden checkoutDate field
            const checkinVal = instance.formatDate(selectedDates[0], "Y-m-d");
            const checkoutVal = instance.formatDate(selectedDates[1], "Y-m-d");
            // Set the checkin input to only hold the first date so validation works on single date?
            // Actually, we'll keep the full string in checkinDate for the UI.
            document.getElementById('checkoutDate').value = checkoutVal;
          } else {
            document.getElementById('checkoutDate').value = "";
          }
        }
      };

      flatpickr("#checkinDate", commonConfig);
    }

    async function loadRoomDetail() {
      if (!roomId) {
        console.error('âŒ [loadRoomDetail] No roomId provided');
        return;
      }

      try {
        const resp = await fetch(`${API_ROOMS}/${roomId}?_=${Date.now()}`);
        if (!resp.ok) throw new Error('KhÃ´ng thá»ƒ táº£i chi tiáº¿t phÃ²ng');

        const room = await resp.json();
        currentRoom = room;

        // Populate basic UI elements (titles, prices, etc)
        document.getElementById('roomTitle').textContent = room.roomTypeName || room.roomType || 'PhÃ²ng';
        document.getElementById('roomSubtitle').textContent = 'Khu nghá»‰ dÆ°á»¡ng cao cáº¥p Resort Deluxe';
        document.getElementById('roomPrice').textContent = vnd(room.pricePerNight || room.basePrice || 0);
        document.getElementById('nightPrice').textContent = vnd(room.pricePerNight || room.basePrice || 0);
        document.getElementById('maxOccupancy').textContent = room.maxOccupancy || '-';
        document.getElementById('roomSize').textContent = room.roomSize || '-';

        // Load image
        let mainImg = room.imageUrl?.trim() || room.image?.trim() || `images/room-1.jpg`;
        const heroGallery = document.getElementById('heroGallery');
        if (heroGallery) {
            heroGallery.style.backgroundImage = `url('${mainImg}')`;
            heroGallery.style.backgroundSize = 'cover';
            heroGallery.style.backgroundPosition = 'center';
            const skel = heroGallery.querySelector('.loading-skeleton');
            if (skel) skel.remove();
        }

        // Initialize Image Gallery thumbs
        const galleryThumbs = document.getElementById('galleryThumbs');
        if (galleryThumbs) {
            let images = [];
            if (room.imageGallery) {
                try {
                    images = JSON.parse(room.imageGallery);
                } catch(e) { console.error('Error parsing ImageGallery', e); }
            }
            if (!images.length && mainImg) {
                images.push(mainImg);
            }

            if (images.length > 1) {
                galleryThumbs.innerHTML = '';
                images.forEach((imgUrl, index) => {
                    const thumb = document.createElement('div');
                    thumb.className = 'gallery-thumb' + (index === 0 ? ' active' : '');
                    thumb.style.backgroundImage = `url('${imgUrl}')`;
                    thumb.onclick = () => {
                        heroGallery.style.backgroundImage = `url('${imgUrl}')`;
                        document.querySelectorAll('.gallery-thumb').forEach(t => t.classList.remove('active'));
                        thumb.classList.add('active');
                    };
                    galleryThumbs.appendChild(thumb);
                });
            } else {
                galleryThumbs.style.display = 'none';
            }
        }

        // Load description
        document.getElementById('roomDescription').innerHTML = `<p style="line-height:1.8;color:var(--text-secondary,#666);">${room.description || 'ChÆ°a cÃ³ mÃ´ táº£ chi tiáº¿t cho phÃ²ng nÃ y.'}</p>`;

        // Load amenities
        const amenitiesGrid = document.getElementById('amenitiesGrid');
        if (amenitiesGrid) {
            let ams = [];
            if (room.amenities && Array.isArray(room.amenities)) { ams = room.amenities; }
            else if (typeof room.amenities === 'string') { ams = room.amenities.split(',').map(s=>s.trim()).filter(Boolean); }
            
            if (ams.length > 0) {
                amenitiesGrid.innerHTML = ams.map(a => `
                  <div style="display:flex;align-items:center;gap:12px;padding:15px;background:var(--bg-card,#f8f9fa);border-radius:10px;border:1px solid var(--border,#eee);">
                    <span style="color:var(--gold,#c8a97e);font-size:20px;">âœ“</span>
                    <span style="font-weight:500;color:var(--text-primary,#333);">${a}</span>
                  </div>
                `).join('');
            } else {
                amenitiesGrid.innerHTML = `
                  <div style="display:flex;align-items:center;gap:12px;padding:15px;background:var(--bg-card,#f8f9fa);border-radius:10px;border:1px solid var(--border,#eee);"><span style="color:var(--gold,#c8a97e);font-size:20px;">âœ“</span><span style="font-weight:500;color:var(--text-primary,#333);">Wifi tá»‘c Ä‘á»™ cao</span></div>
                  <div style="display:flex;align-items:center;gap:12px;padding:15px;background:var(--bg-card,#f8f9fa);border-radius:10px;border:1px solid var(--border,#eee);"><span style="color:var(--gold,#c8a97e);font-size:20px;">âœ“</span><span style="font-weight:500;color:var(--text-primary,#333);">Bá»¯a sÃ¡ng tá»± chá»n</span></div>
                  <div style="display:flex;align-items:center;gap:12px;padding:15px;background:var(--bg-card,#f8f9fa);border-radius:10px;border:1px solid var(--border,#eee);"><span style="color:var(--gold,#c8a97e);font-size:20px;">âœ“</span><span style="font-weight:500;color:var(--text-primary,#333);">Há»“ bÆ¡i vÃ´ cá»±c</span></div>
                  <div style="display:flex;align-items:center;gap:12px;padding:15px;background:var(--bg-card,#f8f9fa);border-radius:10px;border:1px solid var(--border,#eee);"><span style="color:var(--gold,#c8a97e);font-size:20px;">âœ“</span><span style="font-weight:500;color:var(--text-primary,#333);">Dá»‹ch vá»¥ dá»n phÃ²ng 24/7</span></div>
                `;
            }
        }

        // Initialize booking dates and logic
        await initFlatpickr(roomId);
        await loadRoomReviews();
        await loadSimilarRooms(room);
        setupBookingForm(room);
      } catch (err) {
        console.error('Lá»—i táº£i chi tiáº¿t phÃ²ng:', err);
      }
    }

    async function loadSimilarRooms(room) {
      const section = document.getElementById('similarRoomsSection');
      const container = document.getElementById('similarRoomsContainer');
      if (!section || !container) return;
      
      try {
        const resp = await fetch(`${API_ROOMS}?limit=4`);
        if (!resp.ok) return;
        const allRooms = await resp.json();
        
        let similar = allRooms.filter(r => r.roomId != room.roomId && r.isAvailable);
        // Try to match roomType if possible
        const sameType = similar.filter(r => r.roomType === room.roomType);
        if (sameType.length > 0) {
            similar = sameType;
        }
        
        similar = similar.slice(0, 3); // take top 3
        
        if (similar.length === 0) {
            section.style.display = 'none';
            return;
        }
        
        section.style.display = 'block';
        container.innerHTML = similar.map(r => {
            const img = r.imageUrl || r.image || 'images/room-1.jpg';
            return `
            <div class="col-md-4" style="min-width: 280px; max-width: 350px;">
                <div style="background:#fff;border-radius:15px;overflow:hidden;box-shadow:0 10px 30px rgba(0,0,0,0.08);transition:all 0.3s;" onmouseover="this.style.transform='translateY(-10px)'" onmouseout="this.style.transform='translateY(0)'">
                    <a href="room-detail.html?id=${r.roomId}" style="display:block;height:200px;background:url('${img}') center/cover;position:relative;text-decoration:none;">
                        <div style="position:absolute;top:15px;right:15px;background:rgba(255,255,255,0.9);padding:5px 12px;border-radius:20px;font-weight:700;color:#c8a97e;">${vnd(r.pricePerNight)}</div>
                    </a>
                    <div style="padding:20px;">
                        <a href="room-detail.html?id=${r.roomId}" style="text-decoration:none;"><h4 style="font-weight:700;color:#1a1a1a;margin-bottom:10px;font-size:20px;">${r.roomTypeName || r.roomType || 'PhÃ²ng'} ${r.roomNumber || ''}</h4></a>
                        <div style="display:flex;gap:15px;color:#666;font-size:14px;margin-bottom:15px;">
                            <span>ðŸ‘¤ ${r.maxOccupancy} khÃ¡ch</span>
                        </div>
                        <a href="room-detail.html?id=${r.roomId}" style="display:inline-block;padding:8px 20px;border-radius:20px;border:1px solid #c8a97e;color:#c8a97e;text-decoration:none;font-weight:600;transition:all 0.3s;" onmouseover="this.style.background='#c8a97e';this.style.color='#fff'" onmouseout="this.style.background='transparent';this.style.color='#c8a97e'">Xem chi tiáº¿t</a>
                    </div>
                </div>
            </div>`;
        }).join('');
        
      } catch (e) {
          console.error('Error loading similar rooms', e);
      }
    }

    async function loadRoomReviews() {
      const container = document.getElementById('reviewsListContainer');
      if (!container) return;
      container.innerHTML = Array(3).fill(`
        <div style="border:1px solid var(--border,#eee);padding:24px;border-radius:8px;background:var(--bg-card,#fff);margin-bottom:20px;">
          <div style="display:flex;gap:15px;align-items:center;margin-bottom:15px;">
            <div class="loading-skeleton" style="width:50px;height:50px;border-radius:50%;"></div>
            <div style="flex:1;">
              <div class="loading-skeleton" style="height:15px;width:120px;margin-bottom:8px;border-radius:4px;"></div>
              <div class="loading-skeleton" style="height:12px;width:80px;border-radius:4px;"></div>
            </div>
          </div>
          <div class="loading-skeleton" style="height:15px;width:100px;margin-bottom:15px;border-radius:4px;"></div>
          <div class="loading-skeleton" style="height:15px;width:100%;margin-bottom:8px;border-radius:4px;"></div>
          <div class="loading-skeleton" style="height:15px;width:80%;border-radius:4px;"></div>
        </div>
      `).join('');
      
      try {
        const resp = await fetch(`${location.origin}/api/reviews?roomId=${roomId}&_=${Date.now()}`, {cache:'no-store'});
        if (!resp.ok) throw new Error('HTTP error ' + resp.status);
        const data = await resp.json();
        const reviews = Array.isArray(data) ? data : (data?.reviews || data?.items || []);
        
        if (reviews.length === 0) {
          container.innerHTML = '<div class="text-center py-5"><p class="text-muted">ChÆ°a cÃ³ Ä‘Ã¡nh giÃ¡ nÃ o cho phÃ²ng nÃ y.</p></div>';
          return;
        }

        container.innerHTML = reviews.map(r => {
          const avatarUrl = r.customerAvatarUrl || r.CustomerAvatarUrl;
          const initials = (r.customerName || 'K').charAt(0).toUpperCase();
          const avatarHtml = avatarUrl
            ? `<img src="${avatarUrl}" alt="${r.customerName}" style="width:50px;height:50px;border-radius:50%;object-fit:cover;border:2px solid var(--border,#eee);">`
            : `<div style="width:50px;height:50px;border-radius:50%;background:linear-gradient(135deg,var(--gold,#c8a97e),var(--gold-dark,#a08460));color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:18px;border:2px solid var(--border,#eee);">${initials}</div>`;
          const stars = Array.from({length:5},(_,i)=>`<span style="color:${i<r.rating?'var(--gold,#c8a97e)':'#ddd'};font-size:18px;">â˜…</span>`).join('');
          const date = r.createdAt ? new Date(r.createdAt).toLocaleDateString('vi-VN',{year:'numeric',month:'long',day:'numeric'}) : '';
          
          return `
            <div style="border:1px solid var(--border,#eee);padding:24px;border-radius:8px;background:var(--bg-card,#fff);margin-bottom:20px;">
              <div style="display:flex;gap:15px;align-items:center;margin-bottom:15px;">
                ${avatarHtml}
                <div>
                  <div style="font-weight:600;font-size:16px;color:var(--text-primary,#333);">${r.customerName || 'KhÃ¡ch hÃ ng'}</div>
                  <div style="font-size:13px;color:var(--text-muted,#888);">${date}</div>
                </div>
              </div>
              <div style="margin-bottom:12px;">${stars}</div>
              <div style="font-style:italic;color:var(--text-secondary,#666);line-height:1.7;">"${r.comment}"</div>
            </div>`;
        }).join('');
      } catch (e) {
        console.error('Error loading reviews:', e);
        container.innerHTML = '<div class="text-center py-4 text-danger"><p>Lá»—i khi táº£i Ä‘Ã¡nh giÃ¡.</p></div>';
      }
    }

    function setupBookingForm(room) {
      const btnBook = document.getElementById('btnBookNow');
      const bookingModal = new bootstrap.Modal(document.getElementById('bookingInfoModal'));
      let isSubmitting = false;

      if (!btnBook) return;

      btnBook.addEventListener('click', async (e) => {
        e.preventDefault();
        
        const checkin = document.getElementById('checkinDate');
        const checkout = document.getElementById('checkoutDate');
        const numGuests = document.getElementById('numGuests');
        let hasError = false;

        const quickForm = document.getElementById('bookingQuickForm');
        // Validate check-in
        if (quickForm && quickForm.dataset.validate === 'on') {
          const fp = checkin._flatpickr;
          if (!fp || fp.selectedDates.length < 2) {
            createInlineError(checkin, 'Vui lÃ²ng chá»n Ä‘áº§y Ä‘á»§ ngÃ y nháº­n vÃ  tráº£ phÃ²ng');
            hasError = true;
          } else {
            const checkinDate = fp.selectedDates[0];
            const checkoutDate = fp.selectedDates[1];
            const today = new Date();
            today.setHours(0,0,0,0);
            
            if (checkinDate < today) {
              createInlineError(checkin, 'NgÃ y nháº­n phÃ²ng khÃ´ng thá»ƒ lÃ  quÃ¡ khá»©');
              hasError = true;
            } else if (checkoutDate <= checkinDate) {
              createInlineError(checkin, 'NgÃ y tráº£ phÃ²ng pháº£i sau ngÃ y nháº­n phÃ²ng');
              hasError = true;
            } else {
              clearInlineError(checkin);
            }
          }
          
          // Validate guests count
          const selectedGuests = parseInt(numGuests.value) || 1;
          const maxOccupancy = room.maxOccupancy || 4;
          if (selectedGuests > maxOccupancy) {
            const guestWarning = document.getElementById('guestLimitWarning');
            if (guestWarning) {
              guestWarning.style.display = 'block';
              guestWarning.innerHTML = `
                <div style="color:#856404;font-weight:600;margin-bottom:6px;">âš ï¸ Sá»‘ khÃ¡ch vÆ°á»£t quÃ¡ sá»©c chá»©a phÃ²ng</div>
                <div style="color:#856404;margin-bottom:8px;">PhÃ²ng nÃ y chá»‰ cÃ³ thá»ƒ chá»©a tá»‘i Ä‘a <strong>${maxOccupancy} khÃ¡ch</strong>.</div>
                <div style="color:#856404;">
                  <a href="rooms.html?maxOccupancy=${selectedGuests}" style="color:#856404;text-decoration:underline;font-weight:600;">ðŸ‘‰ Xem cÃ¡c phÃ²ng phÃ¹ há»£p cho ${selectedGuests} khÃ¡ch</a>
                </div>
              `;
              guestWarning.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            numGuests.classList.add('is-invalid');
            if (window.formValidation?.createInlineError) {
              window.formValidation.createInlineError(numGuests, `Sá»‘ khÃ¡ch vÆ°á»£t quÃ¡ sá»©c chá»©a (tá»‘i Ä‘a ${maxOccupancy} khÃ¡ch)`);
            }
            return;
          } else {
            const guestWarning = document.getElementById('guestLimitWarning');
            if (guestWarning) guestWarning.style.display = 'none';
            numGuests.classList.remove('is-invalid');
          }
          
          if (hasError) {
            const firstInvalid = quickForm.querySelector('.is-invalid');
            if (firstInvalid) {
              firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
              firstInvalid.focus();
            }
            return;
          }
          
          // Clear any previous errors if all valid
          clearInlineError(checkin);
        }
        
        // Hiá»ƒn thá»‹ tÃ³m táº¯t Ä‘áº·t phÃ²ng (ngÃ y, sá»‘ Ä‘Ãªm, khÃ¡ch)
        const fp = checkin._flatpickr;
        const checkinVal = fp && fp.selectedDates.length > 0 ? fp.formatDate(fp.selectedDates[0], "Y-m-d") : null;
        const checkoutVal = fp && fp.selectedDates.length > 1 ? fp.formatDate(fp.selectedDates[1], "Y-m-d") : null;
        const guestsVal = document.getElementById('numGuests').value;

        // Function to update summary in modal
        const updateBookingSummary = async () => {
          let summary = 'Vui lÃ²ng chá»n ngÃ y nháº­n tráº£ phÃ²ng';
          if (checkinVal && checkoutVal) {
            const nights = Math.ceil((new Date(checkoutVal) - new Date(checkinVal)) / (1000*60*60*24));
            const basePrice = (room.pricePerNight || room.basePrice || 0) * nights;
            let appliedCoupon = window.coupons?.getAppliedCoupon ? window.coupons.getAppliedCoupon() : null;
            
            // If coupon is pending, try to validate it now
            if (appliedCoupon && appliedCoupon.pending && appliedCoupon.code) {
              try {
                const summaryEl = document.getElementById('bf_summary');
                if (summaryEl) {
                  summaryEl.innerHTML = '<div style="padding:20px;text-align:center"><div class="spinner-border spinner-border-sm text-primary" role="status"></div><div style="margin-top:10px;color:#6b7280">Äang kiá»ƒm tra mÃ£ giáº£m giÃ¡...</div></div>';
                }
                
                const validatedCoupon = await window.coupons.validateCoupon(appliedCoupon.code);
                window.coupons.saveAppliedCoupon(validatedCoupon);
                appliedCoupon = validatedCoupon;
                
                // Update badge
                const badge = document.getElementById('couponAppliedBadge');
                if (badge) badge.style.display = 'none';
                const couponMsg = document.getElementById('couponMessage');
                if (couponMsg) {
                  couponMsg.style.color = '#10b981';
                  couponMsg.textContent = 'âœ… MÃ£ Ä‘Ã£ Ä‘Æ°á»£c xÃ¡c thá»±c';
                }
              } catch (e) {
                // Validation failed - keep pending status
                console.warn('Coupon validation failed in modal:', e);
              }
            }
            
            const { total, discount } = window.coupons?.calculateDiscountedTotal 
              ? window.coupons.calculateDiscountedTotal(basePrice, appliedCoupon) 
              : { total: basePrice, discount: 0 };
            
            summary = `ðŸ“… ${new Date(checkinVal).toLocaleDateString('vi-VN')} â†’ ${new Date(checkoutVal).toLocaleDateString('vi-VN')} Â· ðŸŒ™ ${nights} Ä‘Ãªm Â· ðŸ‘¥ ${guestsVal} khÃ¡ch`;
            
            if (appliedCoupon) {
              const couponCode = appliedCoupon.code || appliedCoupon.Code || appliedCoupon.code;
              if (appliedCoupon.pending) {
                // Pending coupon (403 case) - still show it
                summary += `\nðŸŽŸï¸ MÃ£: <strong style="color:#f59e0b">${couponCode}</strong> <span style="color:#f59e0b;font-size:12px">(Sáº½ Ä‘Æ°á»£c kiá»ƒm tra khi Ä‘áº·t phÃ²ng)</span>`;
                summary += `\nðŸ’° Tá»•ng cá»™ng: <strong style="color:#c8a97e;font-size:18px">${vnd(basePrice)}</strong> <span style="color:#6b7280;font-size:13px">(ChÆ°a Ã¡p dá»¥ng giáº£m)</span>`;
              } else if (discount > 0) {
                // Validated coupon with discount
                summary += `\nðŸŽŸï¸ MÃ£: <strong>${couponCode}</strong> Â· Giáº£m: <strong style="color:#10b981">-${vnd(discount)}</strong>`;
                summary += `\nðŸ’° Tá»•ng cá»™ng: <strong style="color:#c8a97e;font-size:18px">${vnd(total)}</strong>`;
              } else {
                summary += `\nðŸ’° Tá»•ng cá»™ng: <strong style="color:#c8a97e;font-size:18px">${vnd(basePrice)}</strong>`;
              }
            } else {
              summary += `\nðŸ’° Tá»•ng cá»™ng: <strong style="color:#c8a97e;font-size:18px">${vnd(basePrice)}</strong>`;
            }
          }

          document.getElementById('bf_summary').innerHTML = summary;
        };
        
        // Update summary (will auto-validate pending coupon)
        await updateBookingSummary();

        // Tá»± Ä‘iá»n sáºµn thÃ´ng tin tá»« localStorage náº¿u cÃ³
        try {
          const u = JSON.parse(localStorage.getItem('user')||'{}');
          document.getElementById('bf_fullName').value = u.fullName || '';
          document.getElementById('bf_email').value = u.email || '';
          document.getElementById('bf_phone').value = u.phoneNumber || '';
        } catch(_){}

        bookingModal.show();
      });

      // XÃ¡c nháº­n trong modal -> gá»i submitBooking kÃ¨m thÃ´ng tin
      document.getElementById('confirmBookingBtn').addEventListener('click', async () => {
        if (isSubmitting) return;

        // Trigger form validation
        const form = document.getElementById('bookingInfoForm');
        if (form) {
          const submitEvent = new Event('submit', { bubbles: true, cancelable: true });
          form.dispatchEvent(submitEvent);
          if (submitEvent.defaultPrevented) {
            return; // Validation failed, stop here
          }
        }

        const fullName = (document.getElementById('bf_fullName')?.value||'').trim();
        const email = (document.getElementById('bf_email')?.value||'').trim();
        const phone = (document.getElementById('bf_phone')?.value||'').trim();
        const nationality = (document.getElementById('bf_nationality')?.value||'').trim();
        const idCard = (document.getElementById('bf_idCard')?.value||'').trim();
        const address = (document.getElementById('bf_address')?.value||'').trim();
        const eta = (document.getElementById('bf_eta')?.value||'').trim();
        const payment = (document.getElementById('bf_payment')?.value||'').trim();
        const extraNotes = (document.getElementById('bf_notes')?.value||'').trim();
        const terms = document.getElementById('bf_terms')?.checked || false;

        // Kiá»ƒm tra tá»‘i thiá»ƒu (backup validation)
        if (!fullName || !email || !phone) {
          showToast('Vui lÃ²ng nháº­p Há» tÃªn, Email vÃ  SÄT', 'warning');
          return;
        }

        if (!terms){
          showToast('Vui lÃ²ng Ä‘á»“ng Ã½ Ä‘iá»u khoáº£n & chÃ­nh sÃ¡ch', 'warning');
          return;
        }

        // LÆ°u structured JSON vÃ o SpecialRequests Ä‘á»ƒ Admin Ä‘á»c Ä‘Æ°á»£c rÃµ rÃ ng
        const payload = {
          guestName: fullName,
          guestEmail: email,
          guestPhone: phone,
          nationality,
          idCard,
          address,
          arrivalTime: eta,
          paymentMethod: payment,
          note: extraNotes
        };

        document.getElementById('specialRequests').value = JSON.stringify(payload);
        bookingModal.hide();

        isSubmitting = true; btnBook.disabled = true; btnBook.textContent = 'Äang xá»­ lÃ½...';
        await submitBooking(room).finally(()=>{ isSubmitting = false; btnBook.disabled = false; btnBook.textContent = 'ðŸ“… Äáº·t phÃ²ng ngay'; });
      });
    }

    async function submitBooking(room) {
      const checkin = document.getElementById('checkinDate');
      const checkout = document.getElementById('checkoutDate');
      const numGuests = document.getElementById('numGuests');
      
      const fp = checkin._flatpickr;
      // Validation
      if (!fp || fp.selectedDates.length < 2) {
        showToast('Vui lÃ²ng chá»n Ä‘áº§y Ä‘á»§ ngÃ y nháº­n vÃ  tráº£ phÃ²ng', 'warning');
        checkin.focus();
        return;
      }
      
      const checkinDate = fp.selectedDates[0];
      const checkoutDate = fp.selectedDates[1];
      const today = new Date();
      today.setHours(0,0,0,0);
      
      if (checkinDate < today) {
        showToast('NgÃ y nháº­n phÃ²ng khÃ´ng thá»ƒ lÃ  quÃ¡ khá»©', 'warning');
        checkin.focus();
        return;
      }
      
      if (checkoutDate <= checkinDate) {
        showToast('NgÃ y tráº£ phÃ²ng pháº£i sau ngÃ y nháº­n phÃ²ng', 'warning');
        checkin.focus();
        return;
      }
      
      const nights = Math.ceil((checkoutDate - checkinDate) / (1000 * 60 * 60 * 24));
      if (nights < 1) {
        showToast('Pháº£i Ä‘áº·t tá»‘i thiá»ƒu 1 Ä‘Ãªm', 'warning');
        return;
      }
      
      const guests = parseInt(numGuests.value) || 1;
      if (guests > (room.maxOccupancy || 4)) {
        showToast(`Sá»‘ khÃ¡ch vÆ°á»£t quÃ¡ sá»©c chá»©a (tá»‘i Ä‘a ${room.maxOccupancy || 4} khÃ¡ch)`, 'warning');
        return;
      }

      if (guests <= 0) {
        showToast('Sá»‘ khÃ¡ch khÃ´ng há»£p lá»‡', 'warning');
        return;
      }
      
      // Get applied coupon
      const appliedCoupon = window.coupons?.getAppliedCoupon ? window.coupons.getAppliedCoupon() : null;

      // Kiá»ƒm tra tráº¡ng thÃ¡i phÃ²ng cÃ²n kháº£ dá»¥ng
      try {
        const recheck = await fetch(`${API_ROOMS}/${room.roomId}?_=${Date.now()}`, {cache:'no-store'});
        if (recheck.ok) {
          const latest = await recheck.json();
          if (latest && latest.isAvailable === false) {
            showToast('PhÃ²ng hiá»‡n khÃ´ng cÃ²n kháº£ dá»¥ng, vui lÃ²ng chá»n phÃ²ng khÃ¡c', 'warning');
            return;
          }
        }
      } catch(_) { /* bá» qua náº¿u lá»—i máº¡ng nháº¹ */ }
      
      // Check authentication
      const token = localStorage.getItem('token');
      const userStr = localStorage.getItem('user');
      if (!token || !userStr) {
        showToast('Vui lÃ²ng Ä‘Äƒng nháº­p Ä‘á»ƒ Ä‘áº·t phÃ²ng', 'warning');
        // LÆ°u URL hiá»‡n táº¡i Ä‘á»ƒ redirect láº¡i sau khi login
        const currentUrl = window.location.href;
        setTimeout(() => {
          window.location.href = `login.html?redirect=${encodeURIComponent(currentUrl)}`;
        }, 1500);
        return;
      }
      
      let user;
      try {
        user = JSON.parse(userStr);
        if (!user || !user.customerId) {
          throw new Error('Invalid user data');
        }
      } catch(e) {
        showToast('ThÃ´ng tin ngÆ°á»i dÃ¹ng khÃ´ng há»£p lá»‡. Vui lÃ²ng Ä‘Äƒng nháº­p láº¡i', 'danger');
        setTimeout(() => {
          window.location.href = 'login.html';
        }, 1500);
        return;
      }

      // Láº¥y CustomerId Æ°u tiÃªn tá»« JWT claims, fallback sang user object
      function getCustomerIdFromToken(tok){
        try{ const parts = tok.split('.'); if(parts.length>=2){ const payload = JSON.parse(atob(parts[1])); return payload.CustomerId || payload.customerId || null; } }catch(_){ }
        return null;
      }

      const cidFromToken = getCustomerIdFromToken(token);
      const finalCustomerId = cidFromToken || user.customerId || user.CustomerId || user.userId;

      if (!finalCustomerId) {
        showToast('KhÃ´ng tÃ¬m tháº¥y thÃ´ng tin khÃ¡ch hÃ ng. Vui lÃ²ng Ä‘Äƒng nháº­p láº¡i', 'warning');
        setTimeout(() => window.location.href = '../admin/html/login.html', 2000);
        return;
      }
      
      const basePrice = (room.pricePerNight || room.basePrice || 0) * nights;
      const { total: totalPrice, discount } = window.coupons?.calculateDiscountedTotal 
        ? window.coupons.calculateDiscountedTotal(basePrice, appliedCoupon) 
        : { total: basePrice, discount: 0 };
      
      let confirmMessage = `XÃ¡c nháº­n Ä‘áº·t phÃ²ng?\n\n` +
        `ðŸ“… NgÃ y nháº­n: ${checkinDate.toLocaleDateString('vi-VN')}\n` +
        `ðŸ“… NgÃ y tráº£: ${checkoutDate.toLocaleDateString('vi-VN')}\n` +
        `ðŸŒ™ Sá»‘ Ä‘Ãªm: ${nights} Ä‘Ãªm\n` +
        `ðŸ‘¥ Sá»‘ khÃ¡ch: ${guests} khÃ¡ch\n`;
      
      if (appliedCoupon) {
        const couponCode = appliedCoupon.code || appliedCoupon.Code || appliedCoupon.code;
        if (appliedCoupon.pending) {
          confirmMessage += `ðŸŽŸï¸ MÃ£ giáº£m giÃ¡: ${couponCode} (Sáº½ Ä‘Æ°á»£c kiá»ƒm tra khi Ä‘áº·t phÃ²ng)\n`;
        } else if (discount > 0) {
          confirmMessage += `ðŸŽŸï¸ MÃ£ giáº£m giÃ¡: ${couponCode}\n` +
            `ðŸ’¸ Giáº£m: -${vnd(discount)}\n`;
        }
      }
      
      confirmMessage += `ðŸ’° Tá»•ng tiá»n: ${vnd(totalPrice)}`;
      
      const ok = await showConfirm('XÃ¡c nháº­n Ä‘áº·t phÃ²ng', confirmMessage, 'Äáº·t ngay', 'Há»§y');
      if (!ok) return;
      
      try {
        showPageLoading('Äang xá»­ lÃ½ Ä‘áº·t phÃ²ng...');

        let specialRequestsObj = {};
        const specialRequestsText = document.getElementById('specialRequests')?.value || '';
        
        // Try to parse existing specialRequests if it's JSON
        if (specialRequestsText) {
          try {
            const parsed = JSON.parse(specialRequestsText);
            if (typeof parsed === 'object' && parsed !== null) {
              specialRequestsObj = parsed;
            } else {
              // If it's plain text, store as 'note'
              specialRequestsObj.note = specialRequestsText;
            }
          } catch(_) {
            // If not JSON, store as 'note'
            specialRequestsObj.note = specialRequestsText;
          }
        }
        
        // Add form fields to specialRequests
        const formFields = {
          guestName: document.getElementById('bf_fullName')?.value || '',
          guestEmail: document.getElementById('bf_email')?.value || '',
          guestPhone: document.getElementById('bf_phone')?.value || '',
          nationality: document.getElementById('bf_nationality')?.value || '',
          idCard: document.getElementById('bf_idCard')?.value || '',
          address: document.getElementById('bf_address')?.value || '',
          arrivalTime: document.getElementById('bf_eta')?.value || '',
          paymentMethod: document.getElementById('bf_payment')?.value || '',
        };
        Object.assign(specialRequestsObj, formFields);
        
        // Add note if exists
        const note = document.getElementById('bf_notes')?.value || '';
        if (note) {
          specialRequestsObj.note = (specialRequestsObj.note ? specialRequestsObj.note + '\n' : '') + note;
        }
        
        // Add coupon code if applied (pending or validated)
        if (appliedCoupon) {
          const couponCode = appliedCoupon.code || appliedCoupon.Code || appliedCoupon.code;
          if (couponCode) {
            specialRequestsObj.couponCode = couponCode;
          }
        }
        
        const bookingData = {
          customerId: finalCustomerId,
          requestedRoomType: room.roomTypeName || room.roomType || 'Standard',
          checkInDate: checkinDate.toISOString(),
          checkOutDate: checkoutDate.toISOString(),
          numberOfGuests: guests,
          specialRequests: JSON.stringify(specialRequestsObj),
          source: 'Website'
        };
        
        console.log('ðŸ”µ [submitBooking] Submitting:', bookingData);

        const API_BOOKINGS = location.origin + '/api/bookings';
        const bookingResp = await fetch(API_BOOKINGS, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify(bookingData)
        });
        
        console.log('ðŸ”µ [submitBooking] Response status:', bookingResp.status);

        if (!bookingResp.ok) {
          let errorMessage = `HTTP ${bookingResp.status}: ${bookingResp.statusText}`;
          try {
            const errorData = await bookingResp.json();
            errorMessage = errorData.message || errorMessage;
          } catch(e) {
            const errorText = await bookingResp.text();
            errorMessage = errorText || errorMessage;
          }
          console.error('âŒ [submitBooking] API Error:', errorMessage);
          throw new Error(errorMessage);
        }
        
        const bookingResult = await bookingResp.json();
        console.log('âœ… [submitBooking] Booking created:', bookingResult);
        
        showToast('Äáº·t phÃ²ng thÃ nh cÃ´ng! MÃ£ Ä‘áº·t phÃ²ng: ' + (bookingResult.bookingCode || bookingResult.bookingId), 'success');
        setTimeout(() => {
          window.location.href = `booking-success.html?bookingId=${bookingResult.bookingId || bookingResult.bookingCode}`;
        }, 2000);
        
      } catch(e) {
        console.error('âŒ [submitBooking] Error:', e);
        showToast('Lá»—i Ä‘áº·t phÃ²ng: ' + e.message, 'danger');
      } finally {
        hidePageLoading();
      }
    }
    
    // Navbar scroll effect
    window.addEventListener('scroll', () => {
      const navbar = document.querySelector('.ftco-navbar');
      if (window.scrollY > 50) navbar?.classList.add('scrolled');
      else navbar?.classList.remove('scrolled');
    });

    // Input validation - Cháº·n kÃ½ tá»± Ä‘áº·c biá»‡t vÃ  validate real-time
    document.addEventListener('DOMContentLoaded', function() {
      // Há» vÃ  tÃªn: chá»‰ chá»¯ cÃ¡i, khoáº£ng tráº¯ng, dáº¥u tiáº¿ng Viá»‡t
      const fullNameInput = document.getElementById('bf_fullName');
      if (fullNameInput) {
        fullNameInput.addEventListener('input', function(e) {
          // Chá»‰ cho phÃ©p chá»¯ cÃ¡i, khoáº£ng tráº¯ng, dáº¥u tiáº¿ng Viá»‡t
          let value = e.target.value;
          value = value.replace(/[^a-zA-ZÃ€-á»¹\s]/g, '');
          if (value !== e.target.value) {
            e.target.value = value;
          }
        });
        fullNameInput.addEventListener('blur', function(e) {
          const value = e.target.value.trim();
          if (value && value.length < 2) {
            e.target.setCustomValidity('Há» vÃ  tÃªn pháº£i cÃ³ Ã­t nháº¥t 2 kÃ½ tá»±');
            e.target.classList.add('is-invalid');
          } else {
            e.target.setCustomValidity('');
            e.target.classList.remove('is-invalid');
          }
        });
      }

      // Quá»‘c tá»‹ch: chá»‰ chá»¯ cÃ¡i vÃ  khoáº£ng tráº¯ng
      const nationalityInput = document.getElementById('bf_nationality');
      if (nationalityInput) {
        nationalityInput.addEventListener('input', function(e) {
          let value = e.target.value;
          value = value.replace(/[^a-zA-ZÃ€-á»¹\s]/g, '');
          if (value !== e.target.value) {
            e.target.value = value;
          }
        });
      }

      // CMND/CCCD: chá»‰ sá»‘
      const idCardInput = document.getElementById('bf_idCard');
      if (idCardInput) {
        idCardInput.addEventListener('input', function(e) {
          let value = e.target.value;
          value = value.replace(/[^0-9]/g, '');
          if (value !== e.target.value) {
            e.target.value = value;
          }
        });
        idCardInput.addEventListener('blur', function(e) {
          const value = e.target.value.trim();
          if (value && (value.length < 9 || value.length > 12)) {
            e.target.setCustomValidity('CMND/CCCD pháº£i cÃ³ 9-12 chá»¯ sá»‘');
            e.target.classList.add('is-invalid');
          } else {
            e.target.setCustomValidity('');
            e.target.classList.remove('is-invalid');
          }
        });
      }

      // Äá»‹a chá»‰: chá»¯ cÃ¡i, sá»‘, khoáº£ng tráº¯ng, dáº¥u cÃ¢u cÆ¡ báº£n
      const addressInput = document.getElementById('bf_address');
      if (addressInput) {
        addressInput.addEventListener('input', function(e) {
          // Cho phÃ©p chá»¯ cÃ¡i, sá»‘, khoáº£ng tráº¯ng, dáº¥u pháº©y, dáº¥u cháº¥m, dáº¥u gáº¡ch ngang, dáº¥u gáº¡ch chÃ©o
          let value = e.target.value;
          value = value.replace(/[^a-zA-ZÃ€-á»¹0-9\s,.\-\/]/g, '');
          if (value !== e.target.value) {
            e.target.value = value;
          }
        });
      }

      // Ghi chÃº: tÆ°Æ¡ng tá»± Ä‘á»‹a chá»‰
      const notesInput = document.getElementById('bf_notes');
      if (notesInput) {
        notesInput.addEventListener('input', function(e) {
          // Cho phÃ©p chá»¯ cÃ¡i, sá»‘, khoáº£ng tráº¯ng, dáº¥u cÃ¢u cÆ¡ báº£n
          let value = e.target.value;
          value = value.replace(/[^a-zA-ZÃ€-á»¹0-9\s,.\-!?]/g, '');
          if (value !== e.target.value) {
            e.target.value = value;
          }
          // Hiá»ƒn thá»‹ sá»‘ kÃ½ tá»± cÃ²n láº¡i
          const maxLength = 500;
          const remaining = maxLength - value.length;
          let counter = e.target.parentElement.querySelector('.char-counter');
          if (!counter) {
            counter = document.createElement('small');
            counter.className = 'char-counter text-muted';
            counter.style.cssText = 'font-size:12px;margin-top:4px;display:block';
            e.target.parentElement.appendChild(counter);
          }
          counter.textContent = `CÃ²n láº¡i: ${remaining} kÃ½ tá»±`;
          if (remaining < 50) {
            counter.style.color = '#dc3545';
          } else {
            counter.style.color = '#6b7280';
          }
        });
      }

      // Sá»‘ Ä‘iá»‡n thoáº¡i: Ä‘Ã£ cÃ³ pattern, chá»‰ cáº§n validate thÃªm
      const phoneInput = document.getElementById('bf_phone');
      if (phoneInput) {
        phoneInput.addEventListener('input', function(e) {
          let value = e.target.value;
          value = value.replace(/[^0-9]/g, '');
          if (value !== e.target.value) {
            e.target.value = value;
          }
        });
        phoneInput.addEventListener('blur', function(e) {
          const value = e.target.value.trim();
          if (value && (value.length < 9 || value.length > 11)) {
            e.target.setCustomValidity('Sá»‘ Ä‘iá»‡n thoáº¡i pháº£i cÃ³ 9-11 chá»¯ sá»‘');
            e.target.classList.add('is-invalid');
          } else {
            e.target.setCustomValidity('');
            e.target.classList.remove('is-invalid');
          }
        });
      }
    });
    
    loadRoomDetail();
  </script>

