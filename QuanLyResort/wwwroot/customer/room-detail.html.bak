                  <label class="form-label fw-semibold">ÄÃ¡nh giÃ¡ cá»§a báº¡n</label>
                  <div class="star-rating-input" id="roomStarRating" style="display:flex;gap:8px;cursor:pointer;margin-bottom:12px">
                    <span class="star-input" data-rating="1" style="font-size:32px;color:#e5e7eb;transition:all 0.2s;cursor:pointer;pointer-events:auto;user-select:none">â­</span>
                    <span class="star-input" data-rating="2" style="font-size:32px;color:#e5e7eb;transition:all 0.2s;cursor:pointer;pointer-events:auto;user-select:none">â­</span>
                    <span class="star-input" data-rating="3" style="font-size:32px;color:#e5e7eb;transition:all 0.2s;cursor:pointer;pointer-events:auto;user-select:none">â­</span>
                    <span class="star-input" data-rating="4" style="font-size:32px;color:#e5e7eb;transition:all 0.2s;cursor:pointer;pointer-events:auto;user-select:none">â­</span>
                    <span class="star-input" data-rating="5" style="font-size:32px;color:#e5e7eb;transition:all 0.2s;cursor:pointer;pointer-events:auto;user-select:none">â­</span>
                  </div>
                  <input type="hidden" id="roomSelectedRating" name="rating" value="0" required data-label="ÄÃ¡nh giÃ¡">
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Ná»™i dung Ä‘Ã¡nh giÃ¡</label>
                  <textarea class="form-control" id="roomReviewComment" name="comment" rows="4" placeholder="Chia sáº» tráº£i nghiá»‡m cá»§a báº¡n vá»›i phÃ²ng nÃ y..." required data-label="Ná»™i dung Ä‘Ã¡nh giÃ¡" minlength="10" style="font-size:15px;padding:12px"></textarea>
                </div>
                <div style="display:flex;gap:12px">
                  <button type="submit" class="btn" data-action="submit" style="background:linear-gradient(135deg,#c8a97e 0%,#b89968 100%);color:#fff;padding:12px 32px;border-radius:12px;font-weight:600;border:none">
                    Gá»­i Ä‘Ã¡nh giÃ¡
                  </button>
                  <button type="button" class="btn btn-outline-secondary" id="btnCancelReview" data-action="cancel" style="padding:12px 32px;border-radius:12px;font-weight:600">
                    Há»§y
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>

