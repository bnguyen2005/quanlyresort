# =============================================================
# QuanLyResort — Environment Variables Template
# =============================================================
# HƯỚNG DẪN:
#   1. Copy file này thành ".env" (local) hoặc cấu hình trực tiếp
#      trên dashboard của Render / Railway / Docker.
#   2. File ".env" KHÔNG được commit vào git (đã có trong .gitignore).
#   3. ASP.NET Core đọc env vars với dấu "__" thay cho ":" trong JSON.
#      Ví dụ: JwtSettings__SecretKey → appsettings.json: JwtSettings.SecretKey
# =============================================================

# ── DATABASE ─────────────────────────────────────────────────
# SQLite (file-based, phù hợp Render free tier):
ConnectionStrings__DefaultConnection=Data Source=/data/resort.db

# SQL Server (production):
# ConnectionStrings__DefaultConnection=Server=your-server;Database=ResortDb;User Id=sa;Password=yourpwd;

# ── JWT AUTHENTICATION ────────────────────────────────────────
# BẮT BUỘC: Chuỗi ngẫu nhiên tối thiểu 32 ký tự
# Tạo bằng: openssl rand -base64 48
JwtSettings__SecretKey=CHANGE_ME_USE_openssl_rand_-base64_48
JwtSettings__Issuer=ResortManagementAPI
JwtSettings__Audience=ResortManagementClient
JwtSettings__ExpirationHours=24

# ── EMAIL (SMTP GMAIL) ────────────────────────────────────────
# Tạo App Password tại: Google Account → Security → 2-Step Verification → App passwords
EmailSettings__SmtpHost=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SmtpUsername=your-email@gmail.com
EmailSettings__SmtpPassword=your-16-char-app-password
EmailSettings__FromEmail=your-email@gmail.com
EmailSettings__FromName=Resort Deluxe
EmailSettings__EnableSsl=true
EmailSettings__ContactRecipient=your-email@gmail.com

# ── PAYMENT: PAYOS ───────────────────────────────────────────
# Lấy từ: https://my.payos.vn/
BankWebhook__PayOs__ClientId=
BankWebhook__PayOs__ApiKey=
BankWebhook__PayOs__ChecksumKey=
BankWebhook__PayOs__SecretKey=
BankWebhook__PayOs__VerifySignature=true
BankWebhook__PayOs__WebhookUrl=https://your-domain.com/api/simplepayment/webhook

# ── PAYMENT: VIETQR ──────────────────────────────────────────
BankWebhook__VietQR__ClientId=
BankWebhook__VietQR__ApiKey=
BankWebhook__VietQR__ChecksumKey=
BankWebhook__VietQR__SecretKey=
BankWebhook__VietQR__VerifySignature=true
BankWebhook__VietQR__WebhookUrl=https://your-domain.com/api/payment/vietqr-webhook

# ── PAYMENT: MBBANK ──────────────────────────────────────────
BankWebhook__MBBank__ClientId=
BankWebhook__MBBank__ClientSecret=
BankWebhook__MBBank__ApiKey=
BankWebhook__MBBank__SecretKey=
BankWebhook__MBBank__WebhookUrl=https://your-domain.com/api/payment/mbbank-webhook

# ── AI CHAT ──────────────────────────────────────────────────
# Provider options: sample | groq | openai | huggingface | cohere
# Groq free tier: https://console.groq.com/
AIChat__Provider=groq
AIChat__ApiKey=
AIChat__Model=llama-3.1-8b-instant

# ── SMS (tùy chọn) ───────────────────────────────────────────
SmsSettings__Provider=generic
SmsSettings__Enabled=false
SmsSettings__ApiKey=
SmsSettings__ApiSecret=

# ── ASP.NET CORE ─────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:10000
